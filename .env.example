# Copier ce fichier en .env puis remplir les valeurs.
# Le fichier .env ne doit jamais être ajouté à Git.
# Chaque environnement (local, test, production) a ses propres valeurs.
# Les variables qui commencent par VITE_ sont visibles dans le navigateur :
# elles sont publiques et ne contiennent jamais de secret.

# --- Application ---
APP_ENV=
APP_SECRET_KEY=
ALLOWED_ORIGINS=
POSTGRES_ADMIN_PASSWORD=
APP_DATABASE_PASSWORD=
MIGRATION_DATABASE_PASSWORD=
SESSION_COOKIE_SECURE=
SESSION_MAX_AGE_HOURS=
ADMIN_SESSION_IDLE_MINUTES=
DEMO_MODE=

# --- Base de données ---
# Deux comptes distincts : un pour l'application, un pour les migrations.
DATABASE_URL=
DATABASE_MIGRATION_URL=
REDIS_URL=

# --- Limitation de débit (valeurs par défaut) ---
RATE_LIMIT_LOGIN_PER_MINUTE_IP=
RATE_LIMIT_LOGIN_PER_15MIN_ACCOUNT=
RATE_LIMIT_RESET_PER_HOUR_ACCOUNT=
RATE_LIMIT_API_PER_MINUTE=

# --- Fichiers téléversés ---
UPLOAD_MAX_IMAGE_MB=
UPLOAD_MAX_DOCUMENT_MB=
UPLOAD_STORAGE_PATH=

# --- Conservation des données ---
RETENTION_RAW_EVENTS_DAYS=
RETENTION_ALERTS_MONTHS=

# --- Email (V1a) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# --- WhatsApp (V1b) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Paiement (V1b) ---
# La simulation est interdite en production : un test automatique le vérifie.
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- Intelligence artificielle (V1b) ---
AI_ENABLED=
AI_MODE=
LLM_API_KEY=
LLM_MONTHLY_BUDGET_EUR=

# --- Sauvegardes ---
BACKUP_STORAGE_URL=
BACKUP_ENCRYPTION_KEY=

# --- Frontend (publiques) ---
VITE_API_URL=

